`timescale 1ns/1ps

module tb_alu4bit;

    reg [3:0] A;
    reg [3:0] B;
    reg [2:0] ALU_SEL;

    wire [3:0] Y;
    wire CARRY;

    // Instantiate ALU
    alu4bit dut (
        .A(A),
        .B(B),
        .ALU_SEL(ALU_SEL),
        .Y(Y),
        .CARRY(CARRY)
    );

    // Generate waveform
    initial begin
        $dumpfile("alu4bit.vcd");
        $dumpvars(0, tb_alu4bit);
    end

    initial begin

        $display("======================================================");
        $display("                 4-BIT ALU TESTBENCH");
        $display("======================================================");
        $display("Time\tA\tB\tSEL\tY\tCARRY");
        $display("------------------------------------------------------");

        // ADD: 5 + 3 = 8
        A = 4'b0101;
        B = 4'b0011;
        ALU_SEL = 3'b000;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // SUB: 9 - 4 = 5
        A = 4'b1001;
        B = 4'b0100;
        ALU_SEL = 3'b001;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // AND: 1010 & 1100 = 1000
        A = 4'b1010;
        B = 4'b1100;
        ALU_SEL = 3'b010;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // OR: 1010 | 1100 = 1110
        A = 4'b1010;
        B = 4'b1100;
        ALU_SEL = 3'b011;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // XOR: 1010 ^ 1100 = 0110
        A = 4'b1010;
        B = 4'b1100;
        ALU_SEL = 3'b100;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // NOT: ~1010 = 0101
        A = 4'b1010;
        B = 4'b0000;
        ALU_SEL = 3'b101;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // INC: 7 + 1 = 8
        A = 4'b0111;
        B = 4'b0000;
        ALU_SEL = 3'b110;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // DEC: 7 - 1 = 6
        A = 4'b0111;
        B = 4'b0000;
        ALU_SEL = 3'b111;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        // ADD with carry: 15 + 1 = 16
        A = 4'b1111;
        B = 4'b0001;
        ALU_SEL = 3'b000;
        #10;
        $display("%0t\t%b\t%b\t%b\t%b\t%b",
                 $time, A, B, ALU_SEL, Y, CARRY);

        $display("------------------------------------------------------");
        $display("Simulation completed successfully.");
        $display("======================================================");

        $finish;
    end

endmodule